{
    "installCommand": "pnpm install --recursive",
    "buildCommand": "pnpm -w run build:backend",
    "functions": {
        "src/main.ts": {
            "includeFiles": "../../packages/db/generated/prisma/**"
        }
    },
    "rewrites": [
        {
            "source": "/v1/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}