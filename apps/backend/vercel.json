{
    "installCommand": "pnpm install --recursive",
    "buildCommand": "pnpm -w run build:backend",
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/nestjs",
            "config": {
                "includeFiles": "node_modules/@erp/db/dist/prisma/**"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/v1/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}