# Copy this file to .env for local development. Replace placeholders before use.
# Never put real credentials in this example or commit a populated .env file.

# Backend and database
NODE_ENV=development
BACKEND_PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/erp_platform?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Frontend API base URL
VITE_API_BASE_URL=http://localhost:3000/v1/api

# Initial Platform Owner bootstrap only; do not use these as general runtime settings.
PLATFORM_OWNER_EMAIL=owner@example.test
PLATFORM_OWNER_PASSWORD=REPLACE_WITH_A_STRONG_BOOTSTRAP_PASSWORD

# Cookie names. These match the source defaults; keep the CSRF name aligned with the frontend.
REFRESH_TOKEN_COOKIE_NAME=erp360_rtk
CSRF_TOKEN_COOKIE_NAME=erp360_ctk
INSTITUTION_ADMIN_REFRESH_COOKIE_NAME=erp360_ia_rtk
INSTITUTION_ADMIN_CSRF_COOKIE_NAME=erp360_ia_ctk
INSTITUTION_ADMIN_ACCESS_COOKIE_NAME=erp360_ia_at
INSTITUTION_ADMIN_CONTINUATION_COOKIE_NAME=erp360_iac
INSTITUTION_ADMIN_CONTINUATION_CSRF_COOKIE_NAME=erp360_iac_ctk
INSTITUTION_ADMIN_STATUS_COOKIE_NAME=erp360_ias

# Required explicitly in production; choose based on the deployed frontend/API cookie topology.
# Allowed values: lax, strict, none. SameSite=none requires secure HTTPS cookies.
INSTITUTION_ADMIN_COOKIE_SAME_SITE=lax

# Integration tests only. Set per run after verifying a dedicated disposable database.
# Do not uncomment these in the general-purpose .env file.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/erp_test?schema=public
# TEST_DATABASE_DISPOSABLE_ACK=I_HAVE_VERIFIED_THIS_IS_A_NEW_DISPOSABLE_DATABASE
