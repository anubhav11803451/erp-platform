generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountIdentityKind {
  UNASSIGNED
  PLATFORM_OWNER
  INSTITUTION_ADMIN
  INSTITUTION_STAFF
}

enum InstitutionAdminInvitationStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
  LEGACY_ACCEPTED
}

enum InstitutionStaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InstitutionGroupType {
  SCHOOL_SECTION
  COACHING_BATCH
}

enum InstitutionAttendanceMarkStatus {
  PRESENT
  ABSENT
}

model Account {
  id                             String                                   @id @default(uuid())
  email                          String                                   @unique(map: "Account_email_key")
  password_hash                  String
  identity_kind                  AccountIdentityKind                      @default(UNASSIGNED)
  created_at                     DateTime                                 @default(now())
  updated_at                     DateTime                                 @updatedAt
  owner_grant                    PlatformOwnerGrant?
  sessions                       Session[]
  institution_admin_membership   InstitutionAdminMembership?
  institution_staff_membership   InstitutionStaffMembership?
  accepted_admin_invitations     InstitutionAdminInvitation[]             @relation("AcceptedByAccount")
  claimed_admin_invitations      InstitutionAdminInvitation[]             @relation("ClaimedByAccount")
  admin_invitation_continuations InstitutionAdminInvitationContinuation[]
  attendance_marks_updated       InstitutionAttendanceMark[]

  @@unique([id, identity_kind], map: "Account_id_identity_kind_key")
}

model PlatformOwnerGrant {
  account_id                String                       @id
  account_identity_kind     AccountIdentityKind          @default(PLATFORM_OWNER)
  granted_at                DateTime                     @default(now())
  account                   Account                      @relation(fields: [account_id, account_identity_kind], references: [id, identity_kind], onDelete: Cascade, onUpdate: Cascade, map: "OwnerGrant_account_kind_fkey")
  decided_admin_invitations InstitutionAdminInvitation[] @relation("DecidedByOwnerGrant")

  @@unique([account_id, account_identity_kind], map: "PlatformOwnerGrant_account_kind_key")
}

model Session {
  id                 String    @id @default(uuid())
  account_id         String
  /// Shared by rotations of one login; retain predecessor rows/hashes while descendants are active.
  rotation_family_id String
  refresh_token_hash String    @unique
  created_at         DateTime  @default(now())
  expires_at         DateTime
  revoked_at         DateTime?
  account            Account   @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([expires_at])
  @@index([rotation_family_id], type: BTree)
}

model LegalEntity {
  id           String        @id @default(uuid())
  name         String
  /// Nullable for legacy rows; all new LegalEntity create requests provide a code.
  code         String?       @unique(map: "LegalEntity_code_key")
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  institutions Institution[]
}

model Institution {
  id                              String                                   @id @default(uuid())
  legal_entity_id                 String
  name                            String
  /// Nullable for legacy rows; full display codes are derived from the LegalEntity code.
  code_suffix                     String?
  created_at                      DateTime                                 @default(now())
  updated_at                      DateTime                                 @updatedAt
  legal_entity                    LegalEntity                              @relation(fields: [legal_entity_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  admin_memberships               InstitutionAdminMembership[]
  admin_invitations               InstitutionAdminInvitation[]
  /// Null for existing Institutions until an Admin configures an IANA timezone.
  timezone                        String?
  staff_memberships               InstitutionStaffMembership[]
  staff_invitations               InstitutionStaffInvitation[]
  staff_invitation_pending_groups InstitutionStaffInvitationPendingGroup[]
  staff_group_assignments         InstitutionStaffGroupAssignment[]
  groups                          InstitutionGroup[]
  students                        InstitutionStudent[]
  student_group_memberships       InstitutionStudentGroupMembership[]
  attendance_marks                InstitutionAttendanceMark[]

  @@unique([legal_entity_id, code_suffix], map: "Institution_legal_entity_id_code_suffix_key")
  @@index([legal_entity_id], type: BTree)
}

model InstitutionAdminMembership {
  account_id            String              @id
  account_identity_kind AccountIdentityKind @default(INSTITUTION_ADMIN)
  institution_id        String
  created_at            DateTime            @default(now())
  account               Account             @relation(fields: [account_id, account_identity_kind], references: [id, identity_kind], onDelete: Cascade, onUpdate: Cascade, map: "InstitutionAdminMembership_account_kind_fkey")
  institution           Institution         @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([account_id, account_identity_kind], map: "InstitutionAdminMembership_account_kind_key")
  @@index([institution_id], type: BTree)
}

model InstitutionAdminInvitation {
  id                           String                                   @id @default(uuid())
  institution_id               String
  token_hash                   String                                   @unique(map: "InstitutionAdminInvitation_token_hash_key")
  /// Nullable for preserved legacy invitations that were issued without a recipient.
  invited_email                String?
  owner_contact_name           String?
  owner_contact_phone          String?
  status                       InstitutionAdminInvitationStatus         @default(PENDING)
  created_at                   DateTime                                 @default(now())
  expires_at                   DateTime
  accepted_at                  DateTime?
  accepted_by_account_id       String?
  claimed_by_account_id        String?
  claimed_at                   DateTime?
  claimant_name                String?
  review_expires_at            DateTime?
  decided_by_account_id        String?
  decided_at                   DateTime?
  status_credential_hash       String?                                  @unique(map: "InstitutionAdminInvitation_status_credential_hash_key")
  status_credential_expires_at DateTime?
  revoked_at                   DateTime?
  institution                  Institution                              @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accepted_by_account          Account?                                 @relation("AcceptedByAccount", fields: [accepted_by_account_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  claimed_by_account           Account?                                 @relation("ClaimedByAccount", fields: [claimed_by_account_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decided_by_owner_grant       PlatformOwnerGrant?                      @relation("DecidedByOwnerGrant", fields: [decided_by_account_id], references: [account_id], onDelete: Restrict, onUpdate: Cascade)
  continuations                InstitutionAdminInvitationContinuation[]

  // The outstanding-state partial unique index is PostgreSQL-specific and defined in migration SQL.
  @@index([institution_id, status, created_at], type: BTree)
  @@index([institution_id, status, expires_at], type: BTree)
  @@index([institution_id, status, review_expires_at], type: BTree)
  @@index([accepted_by_account_id], type: BTree)
  @@index([claimed_by_account_id], type: BTree)
  @@index([decided_by_account_id], type: BTree)
}

model InstitutionAdminInvitationContinuation {
  id              String                     @id @default(uuid())
  invitation_id   String
  credential_hash String                     @unique(map: "InstitutionAdminInvitationContinuation_credential_hash_key")
  account_id      String?
  csrf_token_hash String
  created_at      DateTime                   @default(now())
  expires_at      DateTime
  revoked_at      DateTime?
  consumed_at     DateTime?
  invitation      InstitutionAdminInvitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account         Account?                   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([invitation_id], type: BTree)
  @@index([account_id], type: BTree)
  @@index([expires_at], type: BTree)
  @@index([revoked_at], type: BTree)
}

model InstitutionStaffMembership {
  account_id            String                            @id
  account_identity_kind AccountIdentityKind               @default(INSTITUTION_STAFF)
  institution_id        String
  created_at            DateTime                          @default(now())
  revoked_at            DateTime?
  account               Account                           @relation(fields: [account_id, account_identity_kind], references: [id, identity_kind], onDelete: Cascade, onUpdate: Cascade, map: "InstitutionStaffMembership_account_kind_fkey")
  institution           Institution                       @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accepted_invitations  InstitutionStaffInvitation[]      @relation("AcceptedByStaffMembership")
  group_assignments     InstitutionStaffGroupAssignment[]

  @@unique([account_id, account_identity_kind], map: "InstitutionStaffMembership_account_kind_key")
  @@unique([institution_id, account_id], map: "InstitutionStaffMembership_institution_account_key")
  @@index([institution_id, revoked_at, created_at], type: BTree)
}

model InstitutionStaffInvitation {
  id                       String                                   @id @default(uuid())
  institution_id           String
  token_hash               String                                   @unique(map: "InstitutionStaffInvitation_token_hash_key")
  normalized_email         String
  status                   InstitutionStaffInvitationStatus         @default(PENDING)
  created_at               DateTime                                 @default(now())
  expires_at               DateTime
  accepted_at              DateTime?
  accepted_by_account_id   String?
  revoked_at               DateTime?
  institution              Institution                              @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accepted_by_membership   InstitutionStaffMembership?              @relation("AcceptedByStaffMembership", fields: [institution_id, accepted_by_account_id], references: [institution_id, account_id], onDelete: Restrict, onUpdate: Cascade)
  pending_group_selections InstitutionStaffInvitationPendingGroup[]

  // Pending email uniqueness is a PostgreSQL partial index defined in the migration.
  @@unique([institution_id, id], map: "InstitutionStaffInvitation_institution_id_id_key")
  @@index([institution_id, status, created_at], type: BTree)
  @@index([institution_id, status, expires_at], type: BTree)
  @@index([institution_id, accepted_by_account_id], type: BTree)
}

model InstitutionStaffInvitationPendingGroup {
  institution_id String
  invitation_id  String
  group_id       String
  institution    Institution                @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitation     InstitutionStaffInvitation @relation(fields: [institution_id, invitation_id], references: [institution_id, id], onDelete: Cascade, onUpdate: Cascade)
  group          InstitutionGroup           @relation(fields: [institution_id, group_id], references: [institution_id, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([institution_id, invitation_id, group_id])
  @@index([institution_id, group_id], type: BTree)
}

model InstitutionStaffGroupAssignment {
  id               String                     @id @default(uuid())
  institution_id   String
  staff_account_id String
  group_id         String
  assigned_at      DateTime                   @default(now())
  revoked_at       DateTime?
  institution      Institution                @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff_membership InstitutionStaffMembership @relation(fields: [institution_id, staff_account_id], references: [institution_id, account_id], onDelete: Cascade, onUpdate: Cascade)
  group            InstitutionGroup           @relation(fields: [institution_id, group_id], references: [institution_id, id], onDelete: Restrict, onUpdate: Cascade)

  // Active assignment uniqueness is a PostgreSQL partial index defined in the migration.
  @@index([institution_id, staff_account_id, revoked_at], type: BTree)
  @@index([institution_id, group_id, revoked_at], type: BTree)
}

model InstitutionGroup {
  id                  String                                   @id @default(uuid())
  institution_id      String
  name                String
  type                InstitutionGroupType
  created_at          DateTime                                 @default(now())
  updated_at          DateTime                                 @updatedAt
  archived_at         DateTime?
  institution         Institution                              @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pending_invitations InstitutionStaffInvitationPendingGroup[]
  staff_assignments   InstitutionStaffGroupAssignment[]
  student_memberships InstitutionStudentGroupMembership[]

  @@unique([institution_id, id], map: "InstitutionGroup_institution_id_id_key")
  @@index([institution_id, archived_at, name], type: BTree)
  @@index([institution_id, type, archived_at], type: BTree)
}

model InstitutionStudent {
  id                String                              @id @default(uuid())
  institution_id    String
  display_name      String
  local_id          String?
  created_at        DateTime                            @default(now())
  updated_at        DateTime                            @updatedAt
  archived_at       DateTime?
  institution       Institution                         @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  group_memberships InstitutionStudentGroupMembership[]

  // Case-insensitive local-ID uniqueness is a PostgreSQL expression index in the migration.
  @@unique([institution_id, id], map: "InstitutionStudent_institution_id_id_key")
  @@index([institution_id, display_name], type: BTree)
  @@index([institution_id, archived_at], type: BTree)
}

model InstitutionStudentGroupMembership {
  institution_id String
  student_id     String
  group_id       String
  created_at     DateTime                    @default(now())
  archived_at    DateTime?
  institution    Institution                 @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student        InstitutionStudent          @relation(fields: [institution_id, student_id], references: [institution_id, id], onDelete: Restrict, onUpdate: Cascade)
  group          InstitutionGroup            @relation(fields: [institution_id, group_id], references: [institution_id, id], onDelete: Restrict, onUpdate: Cascade)
  attendance     InstitutionAttendanceMark[]

  @@id([institution_id, student_id, group_id])
  @@index([institution_id, group_id, archived_at], type: BTree)
  @@index([institution_id, student_id, archived_at], type: BTree)
}

model InstitutionAttendanceMark {
  institution_id           String
  group_id                 String
  student_id               String
  attendance_date          DateTime                          @db.Date
  status                   InstitutionAttendanceMarkStatus
  updated_by_account_id    String
  updated_at               DateTime                          @default(now()) @updatedAt
  institution              Institution                       @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student_group_membership InstitutionStudentGroupMembership @relation(fields: [institution_id, student_id, group_id], references: [institution_id, student_id, group_id], onDelete: Restrict, onUpdate: Cascade)
  updated_by_account       Account                           @relation(fields: [updated_by_account_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([institution_id, group_id, student_id, attendance_date])
  @@index([institution_id, group_id, attendance_date], type: BTree)
  @@index([institution_id, student_id, attendance_date], type: BTree)
}
